<Window x:Class="QrAuthenticity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение подлинности данных в QR-кодах с использованием цифровой подписи"
        Height="840" Width="1200" MinHeight="720" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="#F6F8FA">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0969DA"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0854AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F6F8FA"/>
            <Setter Property="Foreground" Value="#24292F"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAEEF2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#D9383A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B52A2C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <TabControl Background="Transparent" BorderThickness="0">

            <!-- Вкладка 1: Создание подписанного QR-кода -->
            <TabItem Header="1. Создание QR-кода">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="460"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Реквизиты документа" FontSize="16" FontWeight="Bold" Foreground="#1F2328" Margin="0,0,0,12"/>

                                    <TextBlock Text="Номер документа / сертификата:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DocNumberInput" Text="DOC-2026-49328" Padding="8,6" Margin="0,0,0,10"/>

                                    <TextBlock Text="ФИО владельца документа:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="DocOwnerInput" Text="Иванов Иван Иванович" Padding="8,6" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Дата выдачи:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <DatePicker x:Name="DocIssuedPicker" SelectedDateFormat="Short"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Срок действия (опц.):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <DatePicker x:Name="DocExpiresPicker" SelectedDateFormat="Short"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Уровень коррекции ошибок Рида-Соломона:" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                    <ComboBox x:Name="ErrorCorrectionCombo" SelectedIndex="2" Margin="0,0,0,14" Padding="6">
                                        <ComboBoxItem Content="L — Низкий (восстановление до ~7% повреждений)"/>
                                        <ComboBoxItem Content="M — Средний (восстановление до ~15% повреждений)"/>
                                        <ComboBoxItem Content="Q — Повышенный (восстановление до ~25% повреждений)"/>
                                        <ComboBoxItem Content="H — Высокий (восстановление до ~30% повреждений)"/>
                                    </ComboBox>

                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Сформировать и подписать QR" Style="{StaticResource PrimaryButton}" Click="CreateSignedQr_Click" Margin="0,0,8,8"/>
                                        <Button Content="Сохранить в PNG..." Style="{StaticResource SecondaryButton}" Click="SaveQrImage_Click" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Параметры безопасности" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Идентификатор ключа (Key ID):" FontWeight="SemiBold"/>
                                    <TextBox x:Name="CreationKeyIdDisplay" IsReadOnly="True" Background="#F6F8FA" Margin="0,3,0,8" Padding="6"/>

                                    <TextBlock Text="Алгоритм цифровой подписи:" FontWeight="SemiBold"/>
                                    <TextBlock Text="SHA-256 (RSA 2048 бит)" Foreground="#0969DA" FontWeight="SemiBold" Margin="0,2,0,8"/>

                                    <Expander Header="Просмотреть канонический JSON контейнера" Margin="0,4,0,0">
                                        <TextBox x:Name="CreationJsonPreview" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="140" Margin="0,8,0,0" Padding="6" Background="#F6F8FA" FontFamily="Consolas" FontSize="11"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Графический образ QR-кода с цифровой подписью" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                            
                            <Border Grid.Row="1" BorderBrush="#E1E4E8" BorderThickness="1" Background="#FAFAFA" CornerRadius="4" Padding="16">
                                <Image x:Name="GeneratedQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <TextBlock Grid.Row="2" x:Name="QrMetricsLabel" Text="QR-код еще не сгенерирован." Foreground="#57606A" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Проверка подлинности и целостности -->
            <TabItem Header="2. Проверка подлинности">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="460"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="Проверяемое изображение QR-кода" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="Загрузить изображение..." Style="{StaticResource PrimaryButton}" Click="LoadVerificationQr_Click" Margin="0,0,8,8"/>
                                    <Button Content="Взять сгенерированный" Style="{StaticResource SecondaryButton}" Click="UseCurrentGeneratedForVerify_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>

                            <Border Grid.Row="1" BorderBrush="#E1E4E8" BorderThickness="1" Background="#FAFAFA" CornerRadius="4" Padding="12">
                                <Image x:Name="VerificationQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <Button Grid.Row="2" Content="Проверить цифровую подпись" Style="{StaticResource PrimaryButton}" Click="RunVerification_Click" Margin="0,14,0,0" Height="38"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border x:Name="StatusBadgeBorder" Style="{StaticResource CardBorder}" Background="#F6F8FA" BorderThickness="2" BorderBrush="#D0D7DE">
                                <StackPanel>
                                    <TextBlock Text="Статус верификации подлинности:" FontWeight="SemiBold" Foreground="#57606A"/>
                                    <TextBlock x:Name="VerificationStatusHeading" Text="Ожидание проверки" FontSize="20" FontWeight="Bold" Foreground="#24292F" Margin="0,6,0,8"/>
                                    <TextBlock x:Name="VerificationMessageDetail" Text="Загрузите изображение QR-кода и нажмите кнопку проверки." TextWrapping="Wrap" FontSize="14" Foreground="#24292F"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Извлеченные реквизиты документа" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Номер документа:" FontWeight="SemiBold" Foreground="#57606A"/>
                                        <TextBlock Grid.Column="1" x:Name="ResultDocNumber" Text="—" FontWeight="Bold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Владелец:" FontWeight="SemiBold" Foreground="#57606A"/>
                                        <TextBlock Grid.Column="1" x:Name="ResultOwner" Text="—" FontWeight="Bold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Дата выдачи:" FontWeight="SemiBold" Foreground="#57606A"/>
                                        <TextBlock Grid.Column="1" x:Name="ResultIssued" Text="—"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Срок действия:" FontWeight="SemiBold" Foreground="#57606A"/>
                                        <TextBlock Grid.Column="1" x:Name="ResultExpires" Text="—"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Идентификатор ключа (Key ID):" FontWeight="SemiBold" Foreground="#57606A"/>
                                        <TextBlock Grid.Column="1" x:Name="ResultKeyId" Text="—" FontFamily="Consolas"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Статус доверия к ключу:" FontWeight="SemiBold" Foreground="#57606A"/>
                                        <TextBlock Grid.Column="1" x:Name="ResultKeyTrustStatus" Text="—"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <Expander Header="Исходный текст полезной нагрузки (JSON)">
                                    <TextBox x:Name="DecodedRawJsonText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="140" Margin="0,8,0,0" Padding="6" Background="#F6F8FA" FontFamily="Consolas" FontSize="11"/>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Демонстрация атак -->
            <TabItem Header="3. Демонстрация атак">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Моделирование атак на данные QR-кода" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="Загрузить изображение..." Style="{StaticResource SecondaryButton}" Click="TamperLoadImage_Click" Margin="0,0,8,8"/>
                                        <Button Content="Взять текущий документ" Style="{StaticResource SecondaryButton}" Click="TamperLoadCurrent_Click" Margin="0,0,8,8"/>
                                    </WrapPanel>

                                    <Border BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12" Background="#FAFAFA">
                                        <StackPanel>
                                            <TextBlock Text="Шаг 1. Отредактируйте реквизиты для имитации подделки:" FontWeight="Bold" Foreground="#1F2328" Margin="0,0,0,8"/>

                                            <TextBlock Text="Номер документа:" Margin="0,2,0,2"/>
                                            <TextBox x:Name="TamperDocNumber" Padding="6" Margin="0,0,0,8"/>

                                            <TextBlock Text="ФИО владельца:" Margin="0,2,0,2"/>
                                            <TextBox x:Name="TamperOwner" Padding="6" Margin="0,0,0,8"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Дата выдачи:" Margin="0,0,0,2"/>
                                                    <DatePicker x:Name="TamperIssuedPicker" SelectedDateFormat="Short"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Срок действия:" Margin="0,0,0,2"/>
                                                    <DatePicker x:Name="TamperExpiresPicker" SelectedDateFormat="Short"/>
                                                </StackPanel>
                                            </Grid>

                                            <Button Content="Сбросить до исходных значений документа" Style="{StaticResource SecondaryButton}" Click="TamperReset_Click" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Шаг 2. Выберите сценарий проверки устойчивости:" FontWeight="Bold" Margin="0,4,0,8"/>

                                    <!-- Сценарий 1 -->
                                    <Border BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Button Content="Атака 1: Подменить данные со старой подписью" Style="{StaticResource DangerButton}" Click="TamperAttackOldSig_Click" Margin="0,0,0,6"/>
                                            <TextBlock Text="В QR запишутся измененные поля из Шага 1, но подпись останется старой. Проверяет, выявит ли система нарушение целостности данных." TextWrapping="Wrap" FontSize="11" Foreground="#57606A"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Сценарий 2 -->
                                    <Border BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="4" Padding="10">
                                        <StackPanel>
                                            <Button Content="Атака 2: Переподписать сторонним ключом" Style="{StaticResource SecondaryButton}" Click="ToggleAttack2Panel_Click" Margin="0,0,0,6"/>
                                            <TextBlock Text="Имитирует создание математически верной подписи, но сгенерированной сторонним закрытым ключом (которого нет в доверенных)." TextWrapping="Wrap" FontSize="11" Foreground="#57606A" Margin="0,0,0,8"/>

                                            <!-- Раскрывающаяся панель настройки атаки 2 -->
                                            <Border x:Name="Attack2SubPanel" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4" Padding="10" Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="Параметры стороннего ключа:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Название ключа злоумышленника:" Margin="0,2,0,2"/>
                                                    <TextBox x:Name="AttackerKeyNameBox" Text="Ключ постороннего лица (не доверен)" Padding="6" Margin="0,0,0,6"/>

                                                    <TextBlock x:Name="AttackerKeyIdDisplay" Text="Key ID атакующего: —" FontFamily="Consolas" FontSize="11" Foreground="#57606A" Margin="0,0,0,8"/>

                                                    <WrapPanel Margin="0,0,0,8">
                                                        <Button Content="Сгенерировать ключ злоумышленника" Style="{StaticResource SecondaryButton}" Click="GenerateAttackerKey_Click" Margin="0,0,6,0"/>
                                                    </WrapPanel>

                                                    <Button Content="Подтвердить и сформировать QR с чужим ключом" Style="{StaticResource DangerButton}" Click="ApplyAttack2_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="280"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Сформированный проверочный QR-код" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                            <Border Grid.Row="1" BorderBrush="#E1E4E8" BorderThickness="1" Background="#FAFAFA" CornerRadius="4" Padding="10">
                                <Image x:Name="TamperedQrPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <Button Grid.Row="2" Content="Отправить образ на проверку" Style="{StaticResource PrimaryButton}" Click="TamperVerifyDirect_Click" Margin="0,12,0,12" Height="36"/>

                            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Заключение верификатора:" FontWeight="SemiBold" Foreground="#57606A"/>
                                    <TextBlock x:Name="TamperResultTitle" Text="Атака еще не запущена" FontSize="17" FontWeight="Bold" Foreground="#24292F" Margin="0,4,0,8"/>
                                    <TextBlock x:Name="TamperResultDetails" Text="Отредактируйте реквизиты и нажмите одну из кнопок атаки." TextWrapping="Wrap" LineHeight="20"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Управление ключами -->
            <TabItem Header="4. Управление ключами">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Ключи для формирования цифровой подписи" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <TextBlock Text="Длина ключа RSA:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="KeySizeCombo" SelectedIndex="0" Margin="0,0,0,12" Padding="6">
                                        <ComboBoxItem Content="2048 бит (стандартный)"/>
                                        <ComboBoxItem Content="3072 бит (повышенная стойкость)"/>
                                    </ComboBox>

                                    <Button Content="Сгенерировать новую пару ключей" Style="{StaticResource PrimaryButton}" Click="GenerateNewKeyPair_Click" Margin="0,0,0,12"/>

                                    <TextBlock Text="Издатель / Название ключа:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="KeyAliasInput" Text="Центральный орган сертификации" Padding="8,6" VerticalContentAlignment="Center"/>

                                        <!-- Кнопки-иконки для сохранения изменений, отмены/снятия выбора и удаления ключа -->
                                        <StackPanel x:Name="AliasActionButtonsPanel" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Button x:Name="SaveAliasIconBtn" Width="30" Height="30" Margin="0,0,4,0" ToolTip="Сохранить изменения названия (✓)" Click="SaveAliasIconBtn_Click" Cursor="Hand" Background="#DEF7EC" BorderBrush="#31C48D" BorderThickness="1">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                                <TextBlock Text="✓" FontWeight="Bold" FontSize="15" Foreground="#046C4E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button x:Name="CancelAliasIconBtn" Width="30" Height="30" Margin="0,0,4,0" ToolTip="Отменить изменения и снять выбор (✕)" Click="CancelAliasIconBtn_Click" Cursor="Hand" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                                <TextBlock Text="✕" FontWeight="Bold" FontSize="13" Foreground="#4B5563" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button x:Name="DeleteAliasIconBtn" Width="30" Height="30" ToolTip="Удалить выбранный ключ из реестра (🗑)" Click="DeleteAliasIconBtn_Click" Cursor="Hand" Background="#FDE8E8" BorderBrush="#F98080" BorderThickness="1">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4"/>
                                                    </Style>
                                                </Button.Resources>
                                                <TextBlock Text="🗑" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Идентификатор текущего ключа (Key ID):" FontWeight="SemiBold"/>
                                    <TextBox x:Name="CurrentKeyIdBox" IsReadOnly="True" Background="#F6F8FA" Padding="6" Margin="0,3,0,12"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Экспорт закрытого ключа" ToolTip="Сохранить закрытый ключ в файл PEM" Style="{StaticResource SecondaryButton}" Click="ExportPrivateKey_Click"/>
                                        <Button Grid.Column="2" Content="Экспорт открытого ключа" ToolTip="Сохранить открытый ключ в файл PEM" Style="{StaticResource SecondaryButton}" Click="ExportPublicKey_Click"/>
                                    </Grid>

                                    <Separator Margin="0,4,0,12"/>

                                    <TextBlock Text="Управление текущим ключом:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Импорт закрытого ключа" ToolTip="Загрузить закрытый ключ из файла PEM" Style="{StaticResource SecondaryButton}" Click="ImportPrivateKey_Click"/>
                                        <Button Grid.Column="2" Content="Добавить открытый в реестр" ToolTip="Добавить текущий открытый ключ в реестр доверенных" Style="{StaticResource SecondaryButton}" Click="AddCurrentKeyToTrusted_Click"/>
                                    </Grid>

                                    <!-- Предпросмотр ключей -->
                                    <TextBlock Text="Открытый ключ для передачи (Public Key PEM):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="PublicKeyPreviewBox" IsReadOnly="True" Height="80" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" Background="#F6F8FA" Padding="6" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                    <TextBlock Text="Предпросмотр закрытого ключа (Private Key PEM):" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="PrivateKeyPreviewBox" IsReadOnly="True" Height="80" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True" Background="#F6F8FA" Padding="6" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Реестр доверенных открытых ключей" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="Список открытых ключей, которым доверяет программа при проверке QR-кода. Выберите ключ из таблицы для просмотра." TextWrapping="Wrap" Foreground="#57606A"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" x:Name="TrustedKeysGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" Margin="0,6,0,12" BorderThickness="1" BorderBrush="#D0D7DE" SelectionChanged="TrustedKeysGrid_SelectionChanged">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0969DA"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0969DA"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
                                        </Style.Resources>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="4,3"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#0969DA"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40"/>
                                    <DataGridTextColumn Header="Издатель / Название" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Key ID" Binding="{Binding KeyId}" Width="140"/>
                                    <DataGridTextColumn Header="Дата добавления" Binding="{Binding AddedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="145"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Grid.Row="2">
                                <Button Content="Импортировать открытый ключ из файла..." Style="{StaticResource PrimaryButton}" Click="ImportTrustedKeyFile_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 5: Эксперименты и надежность -->
            <TabItem Header="5. Эксперименты и надежность">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Исследование помехоустойчивости QR-кода" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Оценка устойчивости распознавания QR-кода при различных физических и оптических искажениях." TextWrapping="Wrap" Foreground="#57606A" Margin="0,0,0,12"/>

                                    <TextBlock Text="Моделируемое искажение:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="DistortionTypeCombo" SelectedIndex="2" Margin="0,0,0,10" Padding="6" SelectionChanged="DistortionTypeCombo_SelectionChanged"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="От:" FontWeight="SemiBold"/>
                                            <TextBox x:Name="ExpStartBox" Text="0" Padding="6" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="До:" FontWeight="SemiBold"/>
                                            <TextBox x:Name="ExpEndBox" Text="35" Padding="6" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Шаг:" FontWeight="SemiBold"/>
                                            <TextBox x:Name="ExpStepBox" Text="5" Padding="6" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Повторов на точку:" FontWeight="SemiBold"/>
                                            <TextBox x:Name="ExpAttemptsBox" Text="10" Padding="6" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Seed (воспроизводимость):" FontWeight="SemiBold"/>
                                            <TextBox x:Name="ExpSeedBox" Text="42" Padding="6" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button x:Name="StartExperimentBtn" Content="Запустить серию экспериментов" Style="{StaticResource PrimaryButton}" Click="StartExperimentSeries_Click" Height="36" Margin="0,0,0,10"/>
                                    <ProgressBar x:Name="ExperimentProgressBar" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,10" Visibility="Collapsed"/>
                                    <TextBlock x:Name="ExperimentStatusLabel" Text="Готов к проведению измерений." Foreground="#57606A" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Образец искажения QR-кода" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Border BorderBrush="#E1E4E8" BorderThickness="1" Background="#FAFAFA" CornerRadius="4" Height="220" Padding="8">
                                        <Image x:Name="DistortedSamplePreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Таблица результатов испытаний" FontSize="16" FontWeight="Bold" Margin="0,0,2,0"/>
                                <TextBlock Text="Вероятность распознавания P_decode и среднее время обработки." Foreground="#57606A"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" x:Name="ExperimentResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#D0D7DE" Margin="0,6,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Искажение" Binding="{Binding Distortion}" Width="160"/>
                                    <DataGridTextColumn Header="Интенсивность" Binding="{Binding Intensity, StringFormat='{}{0:F1}'}" Width="110"/>
                                    <DataGridTextColumn Header="Попыток" Binding="{Binding Attempts}" Width="75"/>
                                    <DataGridTextColumn Header="Распознано" Binding="{Binding DecodeSuccesses}" Width="90"/>
                                    <DataGridTextColumn Header="P_decode" Binding="{Binding DecodeRate, StringFormat='{}{0:P1}'}" Width="90"/>
                                    <DataGridTextColumn Header="Время (мс)" Binding="{Binding AverageDecodeMilliseconds, StringFormat='{}{0:F1}'}" Width="85"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Grid.Row="2">
                                <Button Content="Экспорт таблицы в CSV..." Style="{StaticResource PrimaryButton}" Click="ExportCsv_Click" Margin="0,0,8,0"/>
                                <Button Content="Очистить результаты" Style="{StaticResource SecondaryButton}" Click="ClearExperimentResults_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
