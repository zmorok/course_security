<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QrAuthenticity</RootNamespace>
    <AssemblyName>QrAuthenticity</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);QrAuthenticity.Cutted/**;QrAuthenticity.Cutted.Tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
</Project>
