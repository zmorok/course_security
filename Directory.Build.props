<Project>
  <PropertyGroup>
    <!-- Solution projects live one directory below the root. Keep this path relative:
         absolute output paths containing an apostrophe can break MSBuild item transforms. -->
    <BaseOutputPath>..\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <!-- Keep only Russian and English satellite resource locales across all configurations. -->
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
