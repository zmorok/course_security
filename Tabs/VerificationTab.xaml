<UserControl x:Class="QrAuthenticity.Tabs.VerificationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Выбор источника данных: Изображение QR или ручной ввод текста (с телефона) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Источник данных для проверки" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" x:Name="SourceImageRadio" Content="Изображение QR" IsChecked="True" GroupName="VerifySourceGroup" Height="32" Checked="VerifySourceRadio_Checked"/>
                        <RadioButton Grid.Column="2" x:Name="SourceTextRadio" Content="Текст с телефона" GroupName="VerifySourceGroup" Height="32" Checked="VerifySourceRadio_Checked"/>
                    </Grid>
                </StackPanel>

                <!-- Основная область: панель изображения или панель ручного ввода текста -->
                <Grid Grid.Row="1">
                    <!-- Режим 1: Изображение QR -->
                    <Grid x:Name="ImageSourcePanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Загрузить из файла..." Style="{StaticResource PrimaryButton}" Click="LoadVerificationQr_Click" Height="34" Padding="6,0"/>
                            <Button Grid.Column="2" Content="Взять сгенерированный" Style="{StaticResource SecondaryButton}" Click="UseCurrentGeneratedForVerify_Click" Height="34" Padding="6,0"/>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="#E1E4E8" BorderThickness="1" Background="#FAFAFA" CornerRadius="4" Padding="10">
                            <Image x:Name="VerificationQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                    </Grid>

                    <!-- Режим 2: Ручной ввод зашифрованного payload (с телефона) -->
                    <Grid x:Name="TextSourcePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Полезная нагрузка (шифротекст / JSON):" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="Вставьте считанную строку (отсканированную камерой телефона):" FontSize="11" Foreground="#57606A"/>
                        </StackPanel>

                        <TextBox Grid.Row="1" x:Name="InputRawPayloadText"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Padding="8"
                                 Background="#FAFAFA"
                                 BorderBrush="#D0D7DE"
                                 TextChanged="InputRawPayloadText_TextChanged"/>

                        <WrapPanel Grid.Row="2" Margin="0,6,0,4">
                            <Button Content="Вставить из буфера" Style="{StaticResource SecondaryButton}" Click="PastePayloadFromClipboard_Click" Margin="0,0,6,4" Padding="8,4"/>
                            <Button Content="Взять текущий QR" Style="{StaticResource SecondaryButton}" Click="PasteCurrentGeneratedPayload_Click" Margin="0,0,6,4" Padding="8,4"/>
                            <Button Content="Очистить" Style="{StaticResource SecondaryButton}" Click="ClearPayloadInput_Click" Margin="0,0,6,4" Padding="8,4"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="3" x:Name="PayloadFormatStatusText" Text="Статус формата: поле пусто" FontSize="11" Foreground="#0969DA" Margin="0,2,0,0"/>
                    </Grid>
                </Grid>

                <!-- Нижняя панель: настройка ключа расшифрования и запуск проверки -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Expander Header="Параметры расшифрования полезной нагрузки" Margin="0,0,0,8">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="Симметричный мастер-ключ приложения:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DecryptionKeyInput" Text="QrAuthenticity-MasterKey-2026-Feistel" Padding="6,4" FontFamily="Consolas" FontSize="11"/>
                                <Button Grid.Column="2" Content="Сброс" Style="{StaticResource SecondaryButton}" Click="ResetDecryptionKey_Click" Padding="8,4" ToolTip="Восстановить мастер-ключ по умолчанию"/>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Button Content="Проверить цифровую подпись и расшифровать" Style="{StaticResource PrimaryButton}" Click="RunVerification_Click" Height="40" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="StatusBadgeBorder" Style="{StaticResource CardBorder}" Background="#F6F8FA" BorderThickness="2" BorderBrush="#D0D7DE">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Статус верификации подлинности:" FontWeight="SemiBold" Foreground="#57606A" VerticalAlignment="Center"/>
                            <Border Width="16" Height="16" CornerRadius="8" Margin="8,0,0,0"
                                    BorderThickness="1.5"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    ToolTipService.InitialShowDelay="0"
                                    ToolTipService.BetweenShowDelay="0"
                                    ToolTipService.ShowDuration="60000">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#8C959F"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#0969DA"/>
                                                <Setter Property="Background" Value="#DDF4FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="i" FontFamily="Georgia" FontWeight="Bold" FontStyle="Italic" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#8C959F"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                                    <Setter Property="Foreground" Value="#0969DA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border.ToolTip>
                                    <ToolTip Background="#FFFFFF" BorderBrush="#D0D7DE" BorderThickness="1" Padding="14,12" HasDropShadow="True">
                                        <StackPanel Width="430">
                                            <TextBlock Text="Статусы верификации подлинности" FontWeight="Bold" FontSize="14" Foreground="#1F2328" Margin="0,0,0,10"/>

                                            <!-- 1. Valid -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="#1A7F37" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Подлинность подтверждена" FontWeight="SemiBold" Foreground="#1A7F37" FontSize="12"/>
                                                    <TextBlock Text="Подпись математически верна, ключ издателя доверен, срок действия актуален." TextWrapping="Wrap" Foreground="#57606A" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 2. DecryptionFailed -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="#CF222E" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Ошибка расшифрования" FontWeight="SemiBold" Foreground="#CF222E" FontSize="12"/>
                                                    <TextBlock Text="Шифротекст поврежден или указан неверный симметричный мастер-ключ шифрования." TextWrapping="Wrap" Foreground="#57606A" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 3. InvalidSignature -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="#CF222E" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Подпись неверна (данные изменены)" FontWeight="SemiBold" Foreground="#CF222E" FontSize="12"/>
                                                    <TextBlock Text="Целостность нарушена: реквизиты документа модифицированы либо подпись сфальсифицирована." TextWrapping="Wrap" Foreground="#57606A" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 4. UnknownKey -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="#9A6700" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Ключ издателя не доверен" FontWeight="SemiBold" Foreground="#9A6700" FontSize="12"/>
                                                    <TextBlock Text="Идентификатор ключа (kid) отсутствует в локальном реестре доверенных ключей." TextWrapping="Wrap" Foreground="#57606A" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 5. Expired -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="#BC4C00" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Срок действия истек" FontWeight="SemiBold" Foreground="#BC4C00" FontSize="12"/>
                                                    <TextBlock Text="Криптографическая подпись верна, но дата окончания действия документа уже наступила." TextWrapping="Wrap" Foreground="#57606A" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 6. InvalidPayload -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="#CF222E" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Неверный формат контейнера" FontWeight="SemiBold" Foreground="#CF222E" FontSize="12"/>
                                                    <TextBlock Text="Полезная нагрузка повреждена, не является валидным JSON или нарушена структура Base64Url." TextWrapping="Wrap" Foreground="#57606A" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 7. UnsupportedVersion / UnsupportedAlgorithm -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="#9A6700" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Несовместимый протокол" FontWeight="SemiBold" Foreground="#9A6700" FontSize="12"/>
                                                    <TextBlock Text="Версия протокола (v != 1) или алгоритм подписи (alg != PS256) не поддерживаются." TextWrapping="Wrap" Foreground="#57606A" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 8. QrNotDecoded -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="#8C959F" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="QR-код не распознан" FontWeight="SemiBold" Foreground="#57606A" FontSize="12"/>
                                                    <TextBlock Text="Сканер не смог прочитать матрицу из-за размытия, шума или физических дефектов." TextWrapping="Wrap" Foreground="#57606A" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="VerificationStatusHeading" Text="Ожидание проверки" FontSize="20" FontWeight="Bold" Foreground="#24292F" Margin="0,6,0,8"/>
                        <TextBlock x:Name="VerificationMessageDetail" Text="Загрузите изображение QR-кода или вставьте считанный текст и нажмите кнопку проверки." TextWrapping="Wrap" FontSize="14" Foreground="#24292F"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Извлеченные реквизиты документа" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Номер документа:" FontWeight="SemiBold" Foreground="#57606A"/>
                            <TextBlock Grid.Column="1" x:Name="ResultDocNumber" Text="—" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Владелец:" FontWeight="SemiBold" Foreground="#57606A"/>
                            <TextBlock Grid.Column="1" x:Name="ResultOwner" Text="—" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Дата выдачи:" FontWeight="SemiBold" Foreground="#57606A"/>
                            <TextBlock Grid.Column="1" x:Name="ResultIssued" Text="—"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Срок действия:" FontWeight="SemiBold" Foreground="#57606A"/>
                            <TextBlock Grid.Column="1" x:Name="ResultExpires" Text="—"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Идентификатор ключа (Key ID):" FontWeight="SemiBold" Foreground="#57606A"/>
                            <TextBlock Grid.Column="1" x:Name="ResultKeyId" Text="—" FontFamily="Consolas"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Статус доверия к ключу:" FontWeight="SemiBold" Foreground="#57606A"/>
                            <TextBlock Grid.Column="1" x:Name="ResultKeyTrustStatus" Text="—"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Алгоритм цифровой подписи:" FontWeight="SemiBold" Foreground="#57606A"/>
                            <TextBlock Grid.Column="1" x:Name="ResultAlgorithm" Text="—"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Защита полезной нагрузки:" FontWeight="SemiBold" Foreground="#57606A"/>
                            <TextBlock Grid.Column="1" x:Name="ResultEncryptionStatus" Text="—" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Expander Header="Считанный контейнер QR-кода (то, что получено со сканера)" Margin="0,0,0,8">
                            <TextBox x:Name="RawPayloadPreviewText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="100" Margin="0,8,0,0" Padding="6" Background="#F6F8FA" FontFamily="Consolas" FontSize="11"/>
                        </Expander>

                        <Expander Header="Расшифрованный канонический JSON документа">
                            <TextBox x:Name="DecodedRawJsonText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="130" Margin="0,8,0,0" Padding="6" Background="#F6F8FA" FontFamily="Consolas" FontSize="11"/>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
