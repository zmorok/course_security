<Window x:Class="QrAuthenticity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:QrAuthenticity.Tabs"
        Title="Подтверждение подлинности данных в QR-кодах с использованием цифровой подписи"
        Height="840" Width="1200" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Background="#F6F8FA">

    <Grid Margin="12">
        <TabControl Background="Transparent" BorderThickness="0">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <!-- Вкладка 1: Создание подписанного QR-кода -->
            <TabItem Header="1. Создание QR-кода">
                <tabs:QrCreationTab x:Name="CreationTab"/>
            </TabItem>

            <!-- Вкладка 2: Проверка подлинности и целостности -->
            <TabItem Header="2. Проверка подлинности">
                <tabs:VerificationTab x:Name="VerificationTab"/>
            </TabItem>

            <!-- Вкладка 3: Демонстрация атак -->
            <TabItem Header="3. Демонстрация атак">
                <tabs:AttackLabTab x:Name="AttackLabTab"/>
            </TabItem>

            <!-- Вкладка 4: Управление ключами -->
            <TabItem Header="4. Управление ключами">
                <tabs:KeyManagementTab x:Name="KeyManagementTab"/>
            </TabItem>

            <!-- Вкладка 5: Эксперименты и надежность -->
            <TabItem Header="5. Эксперименты и надежность">
                <tabs:ExperimentsTab x:Name="ExperimentsTab"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
