<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QrAuthenticity</RootNamespace>
    <AssemblyName>QrAuthenticity</AssemblyName>
    <AssemblyTitle>Программа подтверждения подлинности данных в QR-кодах</AssemblyTitle>
    <Product>Программа подтверждения подлинности данных в QR-кодах</Product>
  </PropertyGroup>
  <Import Project="..\StandaloneApp.props" />
  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
</Project>
