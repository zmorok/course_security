<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QrAuthenticity.Cutted</RootNamespace>
    <AssemblyName>QrAuthenticity</AssemblyName>
    <AssemblyTitle>Программа подтверждения подлинности данных в QR-кодах</AssemblyTitle>
    <Product>Программа подтверждения подлинности данных в QR-кодах</Product>
  </PropertyGroup>
  <Import Project="..\StandaloneApp.props" />
  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../QrAuthenticity/Cryptography/FeistelCipher.cs" Link="Cryptography/FeistelCipher.cs" />
    <Compile Include="../QrAuthenticity/Cryptography/PayloadEncryptionService.cs" Link="Cryptography/PayloadEncryptionService.cs" />
    <Compile Include="../QrAuthenticity/Models/DocumentData.cs" Link="Models/DocumentData.cs" />
    <Compile Include="../QrAuthenticity/QR/QrCodeService.cs" Link="QR/QrCodeService.cs" />
    <Compile Include="../QrAuthenticity/Serialization/Base64Url.cs" Link="Serialization/Base64Url.cs" />
    <Compile Include="../QrAuthenticity/Serialization/RussianDateOnlyJsonConverter.cs" Link="Serialization/RussianDateOnlyJsonConverter.cs" />
  </ItemGroup>
</Project>
